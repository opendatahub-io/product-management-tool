---
apiVersion: appstudio.redhat.com/v1alpha1
kind: ReleasePlanAdmission
metadata:
{%- if annotations %}
  annotations:
{%- for key, value in annotations.items() %}
    [[ key ]]: [[ value ]]
{%- endfor %}
{%- endif %}
  name: [[ release_plan_admission_name ]]
  namespace: rhtap-releng-tenant
  labels:
    pp.engineering.redhat.com/business-unit: ai
    release.appstudio.openshift.io/block-releases: "false"
spec:
  applications:
    - [[ application_name ]]
  policy: [[ policy_name ]]
  data:
{%- if single_component_mode is not none %}
    singleComponentMode: [[ single_component_mode ]]
{%- endif %}
{%- if cdn_env %}
    cdn:
      env: [[ cdn_env ]]
{%- endif %}
    mapping:
      components:
{%- for component in components %}
{%- if component.rpa_values is defined %}
        - name: [[ component.name ]]
{%- if component.rpa_values.contentType is defined %}
          contentType: [[ component.rpa_values.contentType ]]
{%- endif %}
          staged:
            destination: [[ component.rpa_values.staged.destination ]]
            version: "[[ component.rpa_values.staged.version ]]"
            files:
{%- for file in component.rpa_values.staged.files %}
              - filename: [[ file.filename ]]
                source: [[ file.source ]]
{%- endfor %}
{%- if component.rpa_values.contentGateway is defined %}
          contentGateway:
            productName: "[[ component.rpa_values.contentGateway.productName ]]"
            productCode: "[[ component.rpa_values.contentGateway.productCode ]]"
            productVersionName: "[[ component.rpa_values.contentGateway.productVersionName ]]"
            filePrefix: "[[ component.rpa_values.contentGateway.filePrefix ]]"
            contentType: [[ component.rpa_values.contentGateway.contentType ]]
{%- endif %}
{%- if component.rpa_values.productInfo is defined %}
          productInfo:
            filePrefix: "[[ component.rpa_values.productInfo.filePrefix ]]"
            productCode: "[[ component.rpa_values.productInfo.productCode ]]"
            productName: "[[ component.rpa_values.productInfo.productName ]]"
            productVersionName: "[[ component.rpa_values.productInfo.productVersionName ]]"
{%- endif %}
{%- if component.rpa_values.pushSourceContainer is defined %}
          pushSourceContainer: [[ component.rpa_values.pushSourceContainer | lower ]]
{%- elif component.pushSourceContainer is defined %}
          pushSourceContainer: [[ component.pushSourceContainer | lower ]]
{%- endif %}
{%- if component.rpa_values.starmap is defined %}
          starmap:
[[ component.rpa_values.starmap | to_yaml(12) ]]
{%- endif %}
{%- else %}
        - name: [[ component.name ]]
          repositories:
            - url: {% if release_plan_admission_name.endswith("-rc") or "-rc-" in release_plan_admission_name %}{% if component.stage_rc_repository is defined %}[[ component.stage_rc_repository ]]{% else %}[[ component.prod_repository | replace("registry.redhat.io", "registry.stage.redhat.io") ]]{% endif %}{% elif "stage" in release_plan_admission_name %}[[ component.stage_repository ]]{% else %}[[ component.prod_repository ]]{% endif %}
{%- if component.pushSourceContainer is defined %}
          pushSourceContainer: [[ component.pushSourceContainer | lower ]]
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if cloud_marketplaces_secret %}
      cloudMarketplacesSecret: [[ cloud_marketplaces_secret ]]
      cloudMarketplacesPrePush: [[ cloud_marketplaces_pre_push | lower ]]
{%- endif %}
      defaults:
        pushSourceContainer: [[ push_source_container_default | lower ]]
{%- if tags %}
        tags:
{%- for tag in tags %}
          - "[[ tag ]]"
{%- endfor %}
{%- endif %}
    releaseNotes:
      product_name: [[ product_name ]]
      product_version: "[[ product_version ]]"
      product_id: [[ product_id | list ]]
    intention: [[ intention ]]
{%- if "rh-advisories" in pipeline_path %}
    enforceContainerFirstSecurityLabels: true
{%- endif %}
{%- if sign %}
    sign:
      configMapName: "[[ sign.configMapName ]]"
      cosignSecretName: [[ sign.cosignSecretName ]]
{%- elif is_tech_preview or use_beta_keys %}
    sign:
      configMapName: "hacbs-signing-pipeline-config-redhatbeta2"
      cosignSecretName: konflux-cosign-signing-production
{%- endif %}
  origin: [[ tenant_name ]]
  pipeline:
    pipelineRef:
      resolver: git
      params:
        - name: url
          value: "[[ pipeline_url ]]"
        - name: revision
          value: [[ pipeline_revision ]]
        - name: pathInRepo
          value: "[[ pipeline_path ]]"
    serviceAccountName: [[ service_account_name ]]
    timeouts:
      pipeline: "[[ pipeline_timeout ]]"
      tasks: [[ tasks_timeout ]]

