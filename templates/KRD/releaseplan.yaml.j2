---
apiVersion: appstudio.redhat.com/v1alpha1
kind: ReleasePlan
metadata:
  labels:
    release.appstudio.openshift.io/auto-release: "[[ release_plan_autorelease ]]"
    release.appstudio.openshift.io/standing-attribution: "true"
    release.appstudio.openshift.io/releasePlanAdmission: "[[ release_plan_admission_name ]]"
  namespace: [[ tenant_name ]]
  name: [[ release_plan_name ]]
spec:
  application: [[ application_name ]]
  releaseGracePeriodDays: [[ release_plan_grace_period ]]
  target: rhtap-releng-tenant
